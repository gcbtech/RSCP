# Package status upkeep (on_time -> expected -> past_due, AUTO_TRIM) every
# 15 minutes. Persistent= runs a missed check right after downtime.

[Unit]
Description=RSCP package status upkeep (every 15 minutes)

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=30
Unit=rscp-job@package-maintenance.service

[Install]
WantedBy=timers.target
